# Server
PORT=5000
HOST=0.0.0.0

# Comma-separated API keys accepted from SSH agents
VALID_API_KEYS=demo_api_key_12345,test_key_67890

# JWT secret for dashboard login
JWT_SECRET=change-me-to-a-long-random-string

# SQLite database file
DB_PATH=./data/ssh-monitor.db

# Default admin user (created on first boot)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Set to 1 only when running behind ONE reverse proxy (Render, Nginx) so the real client IP is used
# TRUST_PROXY=1

# Offset applied to log timestamps that carry no timezone (older agents)
LOG_TZ_OFFSET=+07:00
# Timezone used to decide "off-hours" logins (00:00-05:59)
ALERT_TZ=Asia/Bangkok

# ---- Alerts (any channel with its variables set is used) ----
# Minimum incident risk that triggers an alert: LOW | MEDIUM | HIGH | CRITICAL
ALERT_MIN_RISK=HIGH
# LINE Messaging API (LINE Notify was shut down on 2025-03-31):
# channel access token of your LINE Official Account + user/group ID to push to
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_TO=
# DISCORD_WEBHOOK_URL=
# SLACK_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Generic webhook: receives {"text": "...", "incident": {...}}
# WEBHOOK_URL=
