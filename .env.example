# Server
PORT=5000
HOST=0.0.0.0

# Comma-separated API keys accepted from SSH agents
VALID_API_KEYS=demo_api_key_12345,test_key_67890

# JWT secret for dashboard login
JWT_SECRET=change-me-to-a-long-random-string

# SQLite database file
DB_PATH=./data/ssh-monitor.db

# Default admin user (created on first boot)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
