# Server
PORT=5000
HOST=0.0.0.0

# Optional extra static API keys for agents (comma separated). Normally each server gets its own key from /get-key.
# VALID_API_KEYS=

# JWT secret for dashboard login
JWT_SECRET=change-me-to-a-long-random-string

# SQLite database file
DB_PATH=./data/ssh-monitor.db

# Default admin user (created on first boot)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Set to 1 only when running behind ONE reverse proxy (Fly.io, Nginx) so the real client IP is used
# TRUST_PROXY=1

# Offset applied to log timestamps that carry no timezone (older agents)
LOG_TZ_OFFSET=+07:00
# Timezone used to decide "off-hours" logins (00:00-05:59)
ALERT_TZ=Asia/Bangkok

# ---- Alerts (any channel with its variables set is used) ----
# Minimum incident risk that triggers an alert: LOW | MEDIUM | HIGH | CRITICAL
ALERT_MIN_RISK=HIGH
# LINE Messaging API (LINE Notify was shut down on 2025-03-31):
# channel access token of your LINE Official Account + user/group ID to push to
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_TO=
# DISCORD_WEBHOOK_URL=
# SLACK_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Generic webhook: receives {"text": "...", "incident": {...}}
# WEBHOOK_URL=

# ---- Sign-up bot check ----
# Without these, a built-in signed math challenge is used. With them, Cloudflare Turnstile is used.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=

# ---- Google / GitHub sign-up (leave empty to hide the buttons) ----
# Callback URLs: <PUBLIC_URL>/api/auth/oauth/google/callback and /github/callback
# PUBLIC_URL=https://your-app.fly.dev
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ---- Mirror sign-ups to Oracle on your own PC (managed with SQL Developer) ----
# Connect string = Tailscale IP of the PC : listener port / service name
# ORACLE_USER=ssh_monitor
# ORACLE_PASSWORD=
# ORACLE_CONNECT_STRING=100.x.y.z:1521/XEPDB1

# ---- Email (verification emails from the Profile page) ----
# Without SMTP_HOST nothing is sent; the verification link is only printed in the server log.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="SSH Monitor <no-reply@example.com>"
